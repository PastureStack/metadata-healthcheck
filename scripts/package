#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
tag="${TAG:-dev}"
repository="${REPO:-ghcr.io/pasturestack}"
image="${repository}/metadata-healthcheck:${tag}"
revision="${IMAGE_REVISION:-$(git rev-parse HEAD)}"

cp bin/metadata-healthcheck pkg/haproxy/haproxy_reload.sh pkg/haproxy/haproxy_template.cfg \
  LICENSE ORIGIN.md THIRD_PARTY_NOTICES.md package/

docker build \
  --provenance=false \
  --network "${DOCKER_BUILD_NETWORK:-host}" \
  --build-arg UBUNTU_MIRROR="${UBUNTU_MIRROR:-http://archive.ubuntu.com/ubuntu}" \
  --build-arg IMAGE_CREATED="${IMAGE_CREATED:-2026-07-22T09:31:42Z}" \
  --build-arg IMAGE_REVISION="$revision" \
  --build-arg IMAGE_VERSION="$tag" \
  -t "$image" package/

mkdir -p dist
printf '%s\n' "$image" > dist/images
printf 'Built %s\n' "$image"
